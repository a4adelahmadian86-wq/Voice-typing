# Required: generate a unique random secret for requests from Laravel.
FARAST_GATEWAY_TOKEN=replace-with-long-random-secret

# Domestic Runflare gateway forwards chat requests to the external FARAST Cloudflare Worker.
# This URL must be the deployed Worker URL; it is not a model-provider URL.
FARAST_UPSTREAM_GATEWAY_URL=
FARAST_UPSTREAM_GATEWAY_TOKEN=

# The Worker is the default chat provider. Local Qwen is deliberately not enabled by default.
AI_PRIMARY_PROVIDER=upstream
FARAST_LOCAL_LLM_URL=
FARAST_LOCAL_LLM_API_KEY=
FARAST_LOCAL_LLM_MODEL=Qwen3-1.7B-Q4_K_M

# Cloud provider chat fallbacks are disabled by default for privacy.
# Enable only after reviewing the exact provider/model data policy and regional terms.
GEMINI_CHAT_ENABLED=false
GROQ_CHAT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Speech recognition is separate from chat. Groq ASR is optional and may send audio to Groq.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3

# Optional Render speech fallback. Keep empty until the ASR/TTS service is deployed and verified.
FARAST_RENDER_ASR_URL=
FARAST_RENDER_ASR_TOKEN=
FARAST_RENDER_TTS_URL=
FARAST_RENDER_TTS_TOKEN=
FARAST_RENDER_TTS_VOICE_ID=farast-fa-male-v1

EDGE_TTS_VOICE=fa-IR-FaridNeural
EDGE_TTS_EN_VOICE=en-US-AriaNeural
EDGE_TTS_AR_VOICE=ar-SA-HamedNeural
FARAST_VOICE_ID=farast-fa-male-v1

FARAST_MAX_AUDIO_BYTES=12582912
FARAST_MAX_TEXT_CHARS=1200
FARAST_UPSTREAM_TIMEOUT=90
