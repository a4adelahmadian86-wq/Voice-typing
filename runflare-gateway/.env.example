# Required: generate a unique random secret; never reuse a public/demo token.
FARAST_GATEWAY_TOKEN=replace-with-long-random-secret

# Local model server is the primary general-AI engine. Deploy runflare-llm separately.
# The 1.7B Q4 model is a constrained, low-cost fallback—not ChatGPT-level quality.
FARAST_LOCAL_LLM_URL=
FARAST_LOCAL_LLM_API_KEY=
FARAST_LOCAL_LLM_MODEL=Qwen3-1.7B-Q4_K_M
AI_PRIMARY_PROVIDER=local

# Optional Google Colab heavy-model tunnel. This is request routing, NOT a keep-alive guarantee.
# Start the notebook manually, expose its OpenAI-compatible API over HTTPS, then configure:
FARAST_COLAB_LLM_URL=
FARAST_COLAB_LLM_API_KEY=
FARAST_COLAB_LLM_MODEL=farast-heavy

# Persian TTS is Edge TTS first; Render is the fallback.
EDGE_TTS_VOICE=fa-IR-FaridNeural
EDGE_TTS_EN_VOICE=en-US-AriaNeural
EDGE_TTS_AR_VOICE=ar-SA-HamedNeural
FARAST_VOICE_ID=farast-fa-male-v1
FARAST_RENDER_ASR_URL=https://voice-typing-r5r7.onrender.com/v1/transcribe
FARAST_RENDER_ASR_TOKEN=
FARAST_RENDER_TTS_URL=https://voice-typing-r5r7.onrender.com/v1/synthesize
FARAST_RENDER_TTS_TOKEN=
FARAST_RENDER_TTS_VOICE_ID=farast-fa-male-v1

FARAST_MAX_AUDIO_BYTES=12582912
FARAST_MAX_TEXT_CHARS=1200
FARAST_UPSTREAM_TIMEOUT=90
