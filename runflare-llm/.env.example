# Generate a long random key and keep it only in Runflare environment settings.
LLAMA_API_KEY=replace-with-long-random-secret

# Quantized multilingual Qwen3.1.7B; about 1.28 GB download.
LLAMA_MODEL_REPO=ggml-org/Qwen3-1.7B-GGUF
LLAMA_MODEL_QUANT=Q4_K_M
LLAMA_CTX_SIZE=2048
LLAMA_THREADS=1
PORT=8000